# OpenAI (required for canonicalizer agent)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=60000

# Site visibility (published | review | all)
CCF_VISIBILITY=published

# Pipeline controls
CCF_MAX_DRAFTS_PER_RUN=3
CCF_SCOUT_MAX_SIGNALS=30
CCF_SCOUT_REQUEST_DELAY_MS=1200

# Machine export
CCF_MACHINE_EXPORT_STATUSES=published
CCF_CHANGELOG_MAX_COMMITS=50
