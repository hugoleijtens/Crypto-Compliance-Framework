{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Crypto Compliance Framework: Machine Interface (canonical-definitions.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "generatedFrom", "policies", "entries"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.3.0",
      "description": "Schema version for the machine export."
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Deterministic generation timestamp."
    },
    "generatedFrom": { "$ref": "#/$defs/generatedFrom" },
    "policies": { "$ref": "#/$defs/policies" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/machineEntry" }
    }
  },
  "$defs": {
    "frameworkType": {
      "type": "string",
      "enum": [
        "principle",
        "definition",
        "journey",
        "failure-pattern",
        "model",
        "regulatory-context",
        "methodology",
        "use-case"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["draft", "review", "published"]
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "risk": {
      "type": "string",
      "enum": ["low", "medium"]
    },
    "scope": {
      "type": "string",
      "const": "Regulated banking environments in EU/UK"
    },
    "entryIntent": {
      "type": "string",
      "enum": ["definition", "principle", "interpretation"]
    },
    "jurisdiction": {
      "type": "string",
      "enum": ["EU", "UK", "GLOBAL"]
    },
    "regime": {
      "type": "string",
      "enum": ["AMLR", "MiCA", "TFR", "EBA_GUIDANCE", "ESMA_GUIDANCE", "FATF", "OECD_CARF", "EU_DAC8"]
    },
    "referencePolicy": {
      "type": "string",
      "enum": ["EU_ONLY", "GLOBAL_ONLY", "EU_AND_GLOBAL"]
    },
    "agentCapability": {
      "type": "string",
      "enum": [
        "terminology_alignment",
        "policy_explanation",
        "report_drafting",
        "control_design",
        "compliance_decision",
        "customer_risk_scoring",
        "regulatory_conclusion",
        "suspicion_determination",
        "sanctions_determination",
        "legal_interpretation"
      ]
    },
    "agentUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "forbidden"],
      "properties": {
        "allowed": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/agentCapability" }
        },
        "forbidden": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/agentCapability" }
        }
      }
    },
    "interpretationBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doesNotProvideLegalAdvice", "requiresHumanValidation", "prohibitedInferences"],
      "properties": {
        "doesNotProvideLegalAdvice": { "type": "boolean", "const": true },
        "requiresHumanValidation": { "type": "boolean", "const": true },
        "prohibitedInferences": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "authorityTier": {
      "type": "string",
      "enum": ["T0_PRIMARY_LAW", "T1_SUPERVISORY_GUIDANCE", "T2_INDUSTRY_STANDARD", "T3_OPERATIONAL_INTERPRETATION"]
    },
    "authorityTierDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "meaning", "allowedAgentUsage", "forbiddenAgentUsage"],
      "properties": {
        "level": { "type": "integer", "minimum": 1, "maximum": 4 },
        "meaning": { "type": "string", "minLength": 1 },
        "allowedAgentUsage": {
          "type": "array",
          "items": { "$ref": "#/$defs/agentCapability" }
        },
        "forbiddenAgentUsage": {
          "type": "array",
          "items": { "$ref": "#/$defs/agentCapability" }
        }
      }
    },
    "authorityBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tierDrivers", "referenceCountByTier"],
      "properties": {
        "tierDrivers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "referenceCountByTier": {
          "type": "object",
          "additionalProperties": false,
          "required": ["T0_PRIMARY_LAW", "T1_SUPERVISORY_GUIDANCE", "T2_INDUSTRY_STANDARD", "T3_OPERATIONAL_INTERPRETATION"],
          "properties": {
            "T0_PRIMARY_LAW": { "type": "integer", "minimum": 0 },
            "T1_SUPERVISORY_GUIDANCE": { "type": "integer", "minimum": 0 },
            "T2_INDUSTRY_STANDARD": { "type": "integer", "minimum": 0 },
            "T3_OPERATIONAL_INTERPRETATION": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Deterministic SHA-256 hash of a canonical subset of fields."
    },
    "sourceLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "generatedFrom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commitSha",
        "commitShaSource",
        "commitTime",
        "commitTimeSource",
        "dirty",
        "exportStatuses"
      ],
      "properties": {
        "commitSha": { "type": ["string", "null"] },
        "commitShaSource": {
          "type": "string",
          "enum": ["git", "CCF_COMMIT_SHA", "VERCEL_GIT_COMMIT_SHA", "GITHUB_SHA", "unknown"]
        },
        "commitTime": { "type": ["string", "null"] },
        "commitTimeSource": {
          "type": "string",
          "enum": ["git", "CCF_COMMIT_TIME", "generatedAt_fallback", "unknown"]
        },
        "dirty": { "type": "boolean" },
        "exportStatuses": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/status" }
        }
      }
    },
    "conflictPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["precedence", "ifUnclear"],
      "properties": {
        "precedence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["EU_PRIMARY_LAW", "EU_SUPERVISORY_GUIDANCE", "FRAMEWORK_CANONICAL_ENTRY"]
          }
        },
        "ifUnclear": { "type": "string", "const": "defer_to_human" }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conflictPolicy"],
      "properties": {
        "conflictPolicy": { "$ref": "#/$defs/conflictPolicy" }
      }
    },
    "machineEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "type",
        "status",
        "entryIntent",
        "canonicalStatement",
        "definition",
        "scope",
        "confidence",
        "risk",
        "jurisdictions",
        "regimes",
        "referencePolicy",
        "citationVerified",
        "agentUsage",
        "embeddingHint",
        "lastReviewed",
        "canonicalUrl",
        "relatedSlugs",
        "sources",
        "sourceAuthorityCount",
        "sourceDomains",
        "prohibitedInferences",
        "interpretationBoundary",
        "authorityTier",
        "authorityTierDetail",
        "authorityBasis",
        "whyItMattersSummary",
        "failureModeSummary",
        "scopeNonClaimsSummary",
        "source",
        "contentHash"
      ],
      "properties": {
        "slug": { "type": "string", "minLength": 1 },
        "type": { "$ref": "#/$defs/frameworkType" },
        "status": { "$ref": "#/$defs/status" },
        "entryIntent": { "$ref": "#/$defs/entryIntent" },
        "canonicalStatement": { "type": "string", "minLength": 1 },
        "definition": { "type": "string", "minLength": 1 },
        "scope": { "$ref": "#/$defs/scope" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "risk": { "$ref": "#/$defs/risk" },
        "jurisdictions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/jurisdiction" }
        },
        "regimes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/regime" }
        },
        "referencePolicy": { "$ref": "#/$defs/referencePolicy" },
        "citationVerified": { "type": "boolean" },
        "agentUsage": { "$ref": "#/$defs/agentUsage" },
        "embeddingHint": { "type": "string", "minLength": 1 },
        "lastReviewed": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "format": "date"
        },
        "canonicalUrl": { "type": "string", "pattern": "^/framework/.+" },
        "relatedSlugs": {
          "type": "array",
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "sources": {
          "type": "array",
          "maxItems": 5,
          "items": { "$ref": "#/$defs/sourceLink" }
        },
        "sourceAuthorityCount": { "type": "integer", "minimum": 0 },
        "sourceDomains": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "prohibitedInferences": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "interpretationBoundary": { "$ref": "#/$defs/interpretationBoundary" },
        "authorityTier": { "$ref": "#/$defs/authorityTier" },
        "authorityTierDetail": { "$ref": "#/$defs/authorityTierDetail" },
        "authorityBasis": { "$ref": "#/$defs/authorityBasis" },
        "whyItMattersSummary": { "type": "string", "minLength": 1 },
        "failureModeSummary": { "type": "string", "minLength": 1 },
        "scopeNonClaimsSummary": { "type": "string", "minLength": 1 },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contentPath"],
          "properties": {
            "contentPath": { "type": "string", "minLength": 1 }
          }
        },
        "contentHash": { "$ref": "#/$defs/contentHash" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "published" } } },
          "then": {
            "properties": {
              "relatedSlugs": { "minItems": 2, "maxItems": 3 },
              "sources": { "minItems": 2, "maxItems": 5 },
              "sourceAuthorityCount": { "minimum": 2 },
              "citationVerified": { "const": true }
            }
          }
        }
      ]
    },
    "frontmatter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "status", "confidence", "scope", "risk", "lastReviewed"],
      "properties": {
        "type": { "$ref": "#/$defs/frameworkType" },
        "status": { "$ref": "#/$defs/status" },
        "entryIntent": { "$ref": "#/$defs/entryIntent" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "scope": { "$ref": "#/$defs/scope" },
        "risk": { "$ref": "#/$defs/risk" },
        "jurisdictions": {
          "type": "array",
          "items": { "$ref": "#/$defs/jurisdiction" }
        },
        "regimes": {
          "type": "array",
          "items": { "$ref": "#/$defs/regime" }
        },
        "referencePolicy": { "$ref": "#/$defs/referencePolicy" },
        "citationVerified": { "type": "boolean" },
        "agentUsage": { "$ref": "#/$defs/agentUsage" },
        "entryRiskClass": {
          "type": "string",
          "enum": [
            "definition_low_risk",
            "regulatory_determination",
            "attribution_ownership",
            "illicitness_signals",
            "decisioning",
            "aggregation_risk"
          ]
        },
        "prohibitedInferences": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "lastReviewed": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "format": "date"
        }
      }
    },
    "requiredSections": {
      "type": "array",
      "description": "MDX must contain all section headings in this exact order.",
      "items": {
        "type": "string",
        "enum": [
          "Canonical Statement",
          "Definition",
          "Why It Matters",
          "Failure Mode if Ignored",
          "Scope & Non-Claims",
          "Related Concepts",
          "Sources"
        ]
      }
    },
    "frameworkGraphExport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "generatedAt", "nodes", "edges"],
      "properties": {
        "schemaVersion": { "type": "string", "const": "1.3.0" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/graphNode" }
        },
        "edges": {
          "type": "array",
          "items": { "$ref": "#/$defs/graphEdge" }
        }
      }
    },
    "graphNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "type", "status", "confidence", "risk", "lastReviewed"],
      "properties": {
        "slug": { "type": "string", "minLength": 1 },
        "type": { "$ref": "#/$defs/frameworkType" },
        "status": { "$ref": "#/$defs/status" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "risk": { "$ref": "#/$defs/risk" },
        "lastReviewed": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "format": "date"
        }
      }
    },
    "graphEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "kind"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "const": "related-concept" }
      }
    }
  }
}

